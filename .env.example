MIDAS_MODE=demo
MIDAS_DATABASE_URL=sqlite+aiosqlite:///./data/midas.db
MIDAS_ARENA_ROOT=./data/arena
MIDAS_LABORATORY_ROOT=./data/laboratory
MIDAS_RECORDING_ROOT=./data/recordings
MIDAS_MARKET_LIMIT=20
MIDAS_REFRESH_SECONDS=30
MIDAS_METADATA_REFRESH_SECONDS=300
MIDAS_MAX_DATA_AGE_MS=15000
MIDAS_RECORDING_MAX_BYTES=100000000
MIDAS_RETENTION_DAYS=30
# Frontier stores separately and never probes unless a venue flag is true.
MIDAS_FRONTIER_ROOT=data/frontier-store
MIDAS_FRONTIER_STORE_MAX_BYTES=67108864
MIDAS_FRONTIER_POLYMARKET_PUBLIC_PROBE_ENABLED=false
MIDAS_FRONTIER_KALSHI_PUBLIC_PROBE_ENABLED=false
MIDAS_FRONTIER_KRAKEN_PUBLIC_PROBE_ENABLED=false
MIDAS_FRONTIER_KRAKEN_PAIRS=XBTUSD
MIDAS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MIDAS_PAPER_CAPITAL=100
MIDAS_PAPER_EXECUTION_MODEL=standard
MIDAS_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
