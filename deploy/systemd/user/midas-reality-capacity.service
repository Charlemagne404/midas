[Unit]
Description=MIDAS Reality recording capacity and reserve monitor

[Service]
Type=oneshot
WorkingDirectory=%h/midas-reality
ExecStart=%h/midas-reality/.venv/bin/python -m midas.reality.operations capacity --config %h/midas-reality/deploy/reality.json --output %h/midas-reality/data/recordings/capacity.json --archive-path /mnt/continental-cloud/data/midas-reality-staging/archive-mission3 --archive-budget-bytes 103079215104 --archive-reserve-bytes 429496729600 --archive-mountpoint /mnt/continental-cloud
MemoryMax=128M
CPUQuota=100%
Nice=15
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/midas-reality/data/recordings
PrivateTmp=true
TimeoutStartSec=60
