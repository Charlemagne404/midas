[Unit]
Description=Midas research API and Laboratory coordinator
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=2

[Service]
Type=simple
WorkingDirectory=%h/midas
Environment=MIDAS_MODE=demo
Environment=MIDAS_LABORATORY_ROOT=%h/midas/data/laboratory-final
Environment=MIDAS_VERITAS_WORKSPACE=%h/midas-veritas
Environment=MIDAS_REALITY_WORKSPACE=%h/midas-reality
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/midas/.venv/bin/uvicorn apps.api.main:app --host 127.0.0.1 --port 8000 --timeout-graceful-shutdown 60
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
KillMode=control-group
TimeoutStartSec=15min
TimeoutStopSec=90
CPUQuota=100%
MemoryHigh=1536M
MemoryMax=1792M
MemorySwapMax=0
Nice=10
IOSchedulingClass=idle
IOWeight=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=midas-api

[Install]
WantedBy=default.target
