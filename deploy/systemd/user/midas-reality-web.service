[Unit]
Description=MIDAS native Reality development interface
After=midas-reality-api.service

[Service]
Type=simple
WorkingDirectory=%h/midas-reality/apps/web
Environment=MIDAS_API_TARGET=http://127.0.0.1:8010
ExecStart=/usr/bin/node %h/midas-reality/apps/web/node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5180 --strictPort
Restart=on-failure
RestartSec=10
MemoryMax=512M
CPUQuota=25%
Nice=15

[Install]
WantedBy=default.target
