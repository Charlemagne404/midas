[Unit]
Description=MIDAS Reality verified incremental raw archival
RequiresMountsFor=/mnt/continental-cloud
ConditionPathIsMountPoint=/mnt/continental-cloud

[Service]
Type=oneshot
WorkingDirectory=%h/midas-reality
ExecStart=%h/midas-reality/.venv/bin/python -m midas.reality.operations archive --config %h/midas-reality/deploy/reality.json --output /mnt/continental-cloud/data/midas-reality-staging/archive-mission3 --budget-bytes 120259084288 --reserve-bytes 429496729600 --resource-admission-timeout-seconds 10800 --operation-timeout-seconds 21600
ExecStartPre=/usr/bin/findmnt --noheadings --output=UUID --target /mnt/continental-cloud --source UUID=2be0060d-8620-4c13-ad02-6e2bada0fb9b
MemoryHigh=640M
MemoryMax=768M
MemorySwapMax=0
# One Python replay worker on this six-thread host. Admission follows active
# MIDAS service I/O PSI; host-wide PSI is advisory because unrelated services
# can dominate it while the protected recorder remains healthy.
CPUQuota=100%
Nice=15
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/continental-cloud/data/midas-reality-staging/archive-mission3
PrivateTmp=true
TimeoutStartSec=6h
