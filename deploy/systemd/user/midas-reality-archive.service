[Unit]
Description=MIDAS Reality verified incremental raw archival

[Service]
Type=oneshot
WorkingDirectory=%h/midas-reality
ExecStart=%h/midas-reality/.venv/bin/python -m midas.reality.operations archive --config %h/midas-reality/deploy/reality.json --output %h/midas-reality/data/recordings/reality-archive-mission2 --budget-bytes 25769803776 --reserve-bytes 21474836480
MemoryMax=256M
CPUQuota=10%
Nice=15
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/midas-reality/data/recordings
PrivateTmp=true
TimeoutStartSec=1800
