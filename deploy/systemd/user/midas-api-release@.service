[Unit]
Description=MIDAS unified API release %i
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=2

[Service]
Type=simple
WorkingDirectory=%h/.local/state/midas
StateDirectory=midas
EnvironmentFile=%h/.config/midas/releases/%i.env
Environment=MIDAS_RUNTIME_ROOT=%h/.local/state/midas
Environment=MIDAS_RELEASE_ID=%i
Environment=MIDAS_SOURCE_REVISION=%i
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=%h/.local/share/midas/releases/%i/packages
ExecStart=%h/.local/share/midas/venvs/%i/bin/uvicorn --app-dir %h/.local/share/midas/releases/%i apps.api.main:app --host 127.0.0.1 --port 8000 --timeout-graceful-shutdown 60
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
KillMode=control-group
TimeoutStartSec=15min
TimeoutStopSec=90
CPUQuota=100%
MemoryHigh=1536M
MemoryMax=1792M
MemorySwapMax=0
Nice=10
IOSchedulingClass=idle
IOWeight=10
TasksMax=128
LimitNOFILE=16384
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=%h/midas/data
ReadOnlyPaths=%h/midas-reality/data %h/midas-veritas/data
StandardOutput=journal
StandardError=journal
SyslogIdentifier=midas-api-release-%i
