[Unit]
Description=MIDAS Veritas bounded read-only public market observation
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/midas-veritas
ExecStart=/home/charlie/midas/.venv/bin/python scripts/veritas_observatory.py --root %h/midas-veritas/data/veritas-observatory --markets 40 --controls 8 --seed 20261015 --quantities 5,10,20,50,100 --request-interval 1
Environment=PYTHONPATH=%h/midas-veritas/packages
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
MemoryMax=256M
MemorySwapMax=0
CPUQuota=25%
Nice=19
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/midas-veritas/data/veritas-observatory
PrivateTmp=true
TimeoutStartSec=10min
