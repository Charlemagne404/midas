# One mode-0600 file per full release commit under ~/.config/midas/reality/releases/.
# The separate JSON file must contain both root and allowed_storage_root.
# Generate this identity from the exact JSON bytes before any authorized start.
MIDAS_SCHEMA_VERSION=midas-reality-framed-zlib-v1
# Set at the approved cutover; keep this timestamp unchanged across restarts.
# MIDAS_DEPLOYED_AT_UTC=YYYY-MM-DDTHH:MM:SSZ
# MIDAS_CONFIG_ID=sha256:<sha256-of-the-versioned-JSON>
