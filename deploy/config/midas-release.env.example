# Copy to ~/.config/midas/releases/<full-commit>.env and review every path.
# Keep secrets out of release directories and out of this example.
# Add MIDAS_DEPLOYED_AT_UTC=<actual UTC timestamp> when installing a release.
MIDAS_MODE=demo
MIDAS_DATABASE_URL=sqlite+aiosqlite:////home/charlie/midas/data/midas.db
MIDAS_ARENA_ROOT=/home/charlie/midas/data/arena
MIDAS_LABORATORY_ROOT=/home/charlie/midas/data/laboratory-final
MIDAS_RECORDING_ROOT=/home/charlie/midas/data/recordings
MIDAS_REALITY_WORKSPACE=/home/charlie/midas-reality
MIDAS_VERITAS_WORKSPACE=/home/charlie/midas-veritas
MIDAS_FRONTIER_ROOT=/home/charlie/midas/data/frontier-store

# Unsupported or unauthorized source collection remains disabled.
MIDAS_FRONTIER_POLYMARKET_PUBLIC_PROBE_ENABLED=false
MIDAS_FRONTIER_KALSHI_PUBLIC_PROBE_ENABLED=false
MIDAS_FRONTIER_KRAKEN_PUBLIC_PROBE_ENABLED=false
MIDAS_FRONTIER_COINBASE_PUBLIC_PROBE_ENABLED=false
